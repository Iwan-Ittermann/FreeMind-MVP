# Single-topic event build.
# When enabled, the app locks to a single topic identified by its 4-char short_code.
# `/` renders the topic directly, all other short-code routes redirect back, and the
# language switcher is hidden (locale forced to `de`). Nebula theme is default.
# VITE_SINGLE_TOPIC_MODE=true
# VITE_SINGLE_TOPIC_SHORT_CODE=xxxx
